<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_glass"
    android:padding="14dp"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memory_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/arohi_text" />

        <TextView
            android:id="@+id/memory_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/arohi_text_dim"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/memory_edit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add"
        app:tint="@color/arohi_warn"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:contentDescription="সম্পাদনা"
        android:padding="4dp" />

    <ImageView
        android:id="@+id/memory_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/arohi_error"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:contentDescription="মুছুন"
        android:padding="4dp"
        android:layout_marginStart="8dp" />
</LinearLayout>
