<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="90dp"
                android:startColor="#337C4DFF" android:endColor="#00050510" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#160A2E" />
            <stroke android:width="3dp" android:color="#7C4DFF" />
        </shape>
    </item>
</layer-list>
